# ==============================================================================
# Computer Lab Management - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' (or 'server.env' / 'agent.env') and set appropriate values.
# Do NOT commit actual production secrets to version control.
# Generate strong secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CENTRAL SERVER CONFIGURATION (Deploy on Lab Server / Instructor PC)
# ------------------------------------------------------------------------------
# Network bind address and port
LAB_SERVER_HOST=0.0.0.0
LAB_SERVER_PORT=8000

# Security secrets (MUST be long random strings, different from each other)
LAB_APP_SECRET=replace-with-a-random-value-at-least-32-characters-long
LAB_AGENT_ENROLLMENT_SECRET=replace-with-a-different-random-value-at-least-24-characters

# Initial administrator credentials (created on first startup, never overwritten)
LAB_INITIAL_ADMIN_USERNAME=admin
LAB_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Optional bootstrap accounts for testing (leave blank if not needed)
LAB_BOOTSTRAP_VIEWER_USERNAME=
LAB_BOOTSTRAP_VIEWER_PASSWORD=
LAB_BOOTSTRAP_OPERATOR_USERNAME=
LAB_BOOTSTRAP_OPERATOR_PASSWORD=

# Session and cookie security
# Set LAB_SECURE_COOKIES=true when deploying over HTTPS (e.g. behind reverse proxy)
LAB_SECURE_COOKIES=false
LAB_SESSION_MAX_AGE=28800

# Workstation offline timeout in seconds (heartbeat interval is typically 5s)
LAB_OFFLINE_TIMEOUT=15.0

# Database path (SQLite database stored on server filesystem)
LAB_DATABASE_PATH=labmanagement.sqlite3
LAB_AUDIT_MAX_ENTRIES=10000

# Power dry-run safety flag (true = log and simulate only, false = real OS poweroff/reboot)
# Keep 'true' during testing and laboratory trials.
LAB_POWER_DRY_RUN=true


# ------------------------------------------------------------------------------
# 2. CLIENT AGENT CONFIGURATION (Deploy on Lab Workstations)
# ------------------------------------------------------------------------------
# URL of the central lab server (use server's actual LAN IP address, not localhost)
# Example: LAB_SERVER_URL=http://192.168.1.100:8000
LAB_SERVER_URL=http://127.0.0.1:8000

# Agent enrollment token (MUST match the server's LAB_AGENT_ENROLLMENT_SECRET)
LAB_AGENT_TOKEN=replace-with-same-agent-enrollment-secret-from-server

# Heartbeat interval in seconds
LAB_HEARTBEAT_INTERVAL=5.0

# Power dry-run safety flag on agent (must match server policy)
LAB_POWER_DRY_RUN=true

# Remote screen viewing streaming parameters
LAB_SCREEN_CAPTURE_INTERVAL=0.5
LAB_SCREEN_IMAGE_QUALITY=70
LAB_SCREEN_MAX_WIDTH=1920
LAB_SCREEN_MAX_HEIGHT=1080
LAB_SCREEN_MAX_FRAME_RATE=2.0
